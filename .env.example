# Documentation only. Real values belong in Vercel Secret variables.
# Staging uses a separate Vercel Preview project and its own Supabase project.
# Never copy staging credentials into the live project's Production environment.
CARVE_APP_ORIGIN=
CARVE_SUPABASE_URL=
CARVE_SUPABASE_PUBLISHABLE_KEY=
CARVE_SHARED_DATABASE_URL=
CARVE_EXPECTED_PROJECT_REF=
# Operator readiness only: true on the approved staging Preview project.
# This does not enable providers or player sign-in. Leave unset elsewhere.
CARVE_STORAGE_HEALTH_ENABLED=
# Optional PEM CA certificate downloaded from the selected project's settings.
# Hosted DB connections always verify the certificate and hostname.
CARVE_DATABASE_CA_CERT=
CARVE_SESSION_SECRET=
# Enable provider/client registries only after real provider and callback review.
CARVE_GOOGLE_CLIENT_ID=
CARVE_GOOGLE_CLIENT_SECRET=
CARVE_APPLE_SERVICE_ID=
CARVE_APPLE_TEAM_ID=
CARVE_APPLE_KEY_ID=
CARVE_APPLE_PRIVATE_KEY=
CARVE_NATIVE_CLIENTS=
CARVE_NATIVE_PROGRESS_CLIENTS=
